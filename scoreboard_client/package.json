{
  "name": "scoreboard_client",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "start": "vite --host --port 5175",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --fix",
    "build:prod": "env-cmd -f ./.env.production && yarn build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.3.0",
    "env-cmd": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.10",
    "react-particles": "^2.12.2",
    "react-redux": "^9.1.2",
    "react-toggle-dark-mode": "^1.1.1",
    "redux": "^5.0.1",
    "socket.io-client": "^4.8.1",
    "swiper": "^11.1.1",
    "toastr": "^2.1.4",
    "tsparticles-preset-fireworks": "^2.12.0",
    "use-sound": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node-fetch": "^2.6.11",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/toastr": "^2.1.43",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.9"
  },
  "resolutions": {
    "rollup": "4.24.0"
  }
}
